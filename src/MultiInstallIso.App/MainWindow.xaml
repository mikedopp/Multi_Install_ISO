<Window x:Class="MultiInstallIso.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Multi Install ISO"
        Icon="Assets/MultiInstallIso.ico"
        Width="1320" Height="860" MinWidth="960" MinHeight="640"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0E1420">
  <Grid>
    <wv2:WebView2 x:Name="Web" />
    <TextBlock x:Name="Fallback" Visibility="Collapsed" Margin="40" TextWrapping="Wrap"
               Foreground="#E8EEF7" FontFamily="Segoe UI" FontSize="15" />
  </Grid>
</Window>
